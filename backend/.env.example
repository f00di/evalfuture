# Comma-separated exact origins. Do not use "*" in production.
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,https://f00di.github.io

# Enable only on a trusted proxy such as the configured Render service.
TRUST_PROXY_HEADERS=false

# Optional Supabase server-side lead storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Resend notification delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=
